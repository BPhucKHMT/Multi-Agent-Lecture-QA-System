          "range": true,
          "refId": "A"
        }
      ],
      "title": "Tổng request chat",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "puq-prometheus"
      },
      "description": "Tốc độ request là số liệu server; route/outcome là enum cố định.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineWidth": 1,
            "showPoints": "auto",
            "spanNulls": false
          },
          "mappings": [],
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (route, outcome) (rate(puq_chat_requests_total[5m]))",
          "legendFormat": "{{route}} / {{outcome}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Lưu lượng request theo route/kết quả",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "puq-prometheus"
      },
      "description": "Tỷ lệ cache hit/miss; cache disabled không được đưa vào mẫu số.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 1,
            "showPoints": "auto",
            "spanNulls": false
          },
          "mappings": [],
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "100 * sum(rate(puq_chat_requests_total{cache=\"hit\"}[5m])) / clamp_min(sum(rate(puq_chat_requests_total{cache=~\"hit|miss\"}[5m])), 0.000001)",
          "legendFormat": "cache hit %",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "100 * sum(rate(puq_chat_requests_total{cache=\"miss\"}[5m])) / clamp_min(sum(rate(puq_chat_requests_total{cache=~\"hit|miss\"}[5m])), 0.000001)",
          "legendFormat": "cache miss %",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Tỷ lệ cache hit/miss",
      "type": "timeseries"
    },
