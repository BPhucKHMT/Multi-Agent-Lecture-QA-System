# =================================================================
# 🔑 API KEYS & SECRETS
# =================================================================
myAPIKey = "your_api_key_here"
YOUTUBE_API_KEY = "your_youtube_api_key_here"

# =================================================================
# 🤖 LLM CONFIGURATION (OpenAI)
# =================================================================
# Main Models (Tutor, Coding, Math, Quiz)
OPENAI_MODEL = "gpt-6-luna"
OPENAI_MAX_TOKENS = 8192

# Supervisor Model (Experiential Labs Jev primary; direct OpenAI GPT-6 Luna fallback)
OPENAI_SUPERVISOR_MODEL = "gpt-6-luna"
OPENAI_SUPERVISOR_MAX_TOKENS = 1024

# Experiential Labs Jev (Supervisor typed decisions)
EXPERIENTIAL_API_KEY = ""

# Embedding Model
EMBEDDING_MODEL_NAME = "models/production/bge-m3-v3"

# Chunking Strategy
CHUNK_STRATEGY = "recursive"  # Options: recursive, timestamp_150_50, timestamp_90_30, semantic, parent_child_180s_45s
SEMANTIC_EMBEDDING_PROVIDER = "openai"  # "openai" (text-embedding-3-large) or "bge" (fine-tuned BGE-M3)

# =================================================================
# 📦 DATABASE & CACHE
# =================================================================
# PostgreSQL (Supabase)
DATABASE_URL = "postgresql://user:password@localhost:5432/puq"

# Redis local trong Docker Compose; nếu dùng Redis bên ngoài, đặt URL container truy cập được và chạy API với --no-deps (xem README).
REDIS_URL = "redis://redis-stack:6379/0"

# Tắt tính năng prewarm để tiết kiệm chi phí OpenAI
SEMANTIC_CACHE_PREWARM_ENABLED = False

# =================================================================
# 🛡️ SECURITY & JWT
# =================================================================
JWT_SECRET = "replace-with-a-unique-random-secret"
JWT_ALGORITHM = "HS256"
ACCESS_TOKEN_EXPIRE_MINUTES = 30
REFRESH_TOKEN_EXPIRE_DAYS = 7

# =================================================================
# 📁 DIRECTORIES & PATHS
# =================================================================
PUQ_DATA_DIR = "artifacts/data"
PUQ_CHUNKS_DIR = "artifacts/chunks"
PUQ_VECTOR_DB_DIR = "artifacts/database_semantic"
PUQ_VIDEOS_DIR = "artifacts/videos"
PUQ_DATA_EXTRACTION_DIR = "artifacts/data_extraction"
TRANSNET_V2_PATH = "C:\\uit_HK5\\CS431\\final_project\\artifacts\\data_extraction\\TransNetV2"

# =================================================================
# 📈 OBSERVABILITY (OPTIONAL; LEAVE BLANK UNTIL CONFIGURED)
# =================================================================
LANGFUSE_PUBLIC_KEY = ""
LANGFUSE_SECRET_KEY = ""
LANGFUSE_BASE_URL = ""
LANGFUSE_TRACING_ENABLED = ""
LANGFUSE_SAMPLE_RATE = "1"
PUQ_TRACE_CONTENT = ""

# =================================================================
# DOCKER COMPOSE: .\dev.ps1 up chạy CPU + frontend + monitoring.
# =================================================================
# Monitoring: đặt mật khẩu mạnh, riêng cho Grafana. Không cần khi chạy -NoMonitoring.
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=
#
# Windows: chỉ chọn file này sau khi cài windows_exporter native (cổng 9182).
# PUQ_PROMETHEUS_CONFIG=prometheus-windows.yml
# Linux: chọn prometheus-linux.yml và bật thêm profile linux-monitoring.
